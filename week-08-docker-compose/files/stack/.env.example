# Copy to .env and edit.  `.env` MUST be gitignored.
#
# Compose reads .env for variable substitution IN THE YAML ITSELF (${VAR}).
# That is different from `env_file:`, which passes variables INTO a container.
# `docker compose config` shows you which one actually happened.

APP_VERSION=1.0
POSTGRES_USER=postgres
POSTGRES_DB=appdb
